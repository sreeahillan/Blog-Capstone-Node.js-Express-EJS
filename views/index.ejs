<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>blog-home</title>
    <link rel="stylesheet" href="../public/style.css">
</head>
<body>
    <h1>Posts</h1>
    

    <% if(locals.title) { %>
        <% for(let i = 0; i<title.length ; i++) { %>
            <h1><%= title[i].title %></h1>
            <p><%= title[i].content %></p>
            <a href="<%= /edit/ + i %>">Edit</a>
            <a href="/del" + <% i %>>Delete</a>
    <% } %>
    <% } else { %>
        <a href="/new">Create your first blog</a>
        <% } %>
</body>
</html>